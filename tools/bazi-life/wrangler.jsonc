// 命盤人生 on Cloudflare: public/ (the pages, og.png, the English story) is served as Workers Static Assets, and one
// Worker (worker/index.js) answers only /api/* and /admin. Deploy from this folder, on your own computer: npm run deploy
// (builds public/, then npx wrangler deploy, which uploads the changed files of public/ too).
{
  "name": "bazi-life",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  // Static assets are free and do not count against the Free plan's 100,000 Worker requests a day, so the pages keep
  // loading when those run out (the page then pauses its live numbers). Only run_worker_first runs the Worker. The clean
  // URLs (/ and /life → life.html, /chart → index.html, /privacy, /terms) are rewrites in public/_redirects, the headers
  // are in public/_headers, both written by npm run build (scripts/static-site.mjs); any other path gets public/404.html.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/admin"]
  },
  // Workers AI (Gemma 4 26B). The free plan has 10,000 neurons a day: about 950 written choices, or about 28 full AI
  // readings (110 合婚); past that a call fails (the page reads written choices itself, and offers to try a reading later).
  "ai": { "binding": "AI" },
  // Per IP and Cloudflare location, each minute: 12 written choices (/api/interpret) and 20 parts of AI readings
  // (/api/reading; a full reading is 8 parts, 合婚 3). namespace_id must be unique in the account (a binding with the
  // same id in another Worker would share these counters).
  "ratelimits": [
    { "name": "INTERPRET_LIMIT", "namespace_id": "4721", "simple": { "limit": 12, "period": 60 } },
    { "name": "READING_LIMIT", "namespace_id": "4722", "simple": { "limit": 20, "period": 60 } },
    // The back office's anonymous counts (/api/stats): a page sends a few a minute.
    { "name": "STATS_LIMIT", "namespace_id": "4723", "simple": { "limit": 60, "period": 60 } }
  ],
  // The daily totals for /admin, in one SQLite-backed Durable Object (worker/stats-store.js).
  "durable_objects": { "bindings": [{ "name": "STATS", "class_name": "StatsStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StatsStore"] }],
  "vars": {
    // "compact" sends the shorter prompt: about 6 instead of 10 neurons a reading, slightly less accurate.
    "PROMPT": "full",
    // "soon": AI 分析報告 is not open yet; the pages say 敬請期待 and /api/reading answers 503 soon. Remove to open it.
    "AI_READING": "soon"
    // LIVE_DEMO "1" would show made-up live numbers on the welcome page; it is off for good (made-up activity reads as
    // fake social proof under consumer law). Only real numbers show, once there are enough of them (worker/stats.js SHOW).
  },
  "observability": { "enabled": true }
}
