// Production config. Deploy with `npm run deploy`, or connect this folder to Workers Builds
// (root directory: tools/pet-life, deploy command: npm run deploy).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pet-life",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-15",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "ai": { "binding": "AI" },
  "durable_objects": { "bindings": [{ "name": "LIMITER", "class_name": "Limiter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Limiter"] }],
  "vars": {
    // Gemma 4 writes the letters; Qwen3 steps in if Gemma is busy or its answer is unusable.
    "MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "FALLBACK_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
    // Stay well under the free 10,000 neurons per day (a letter costs about 15–25 neurons).
    "NEURON_BUDGET": "8000",
    "NEURONS_PER_LETTER": "25",
    // Letters per network (IP address) per UTC day, on top of one letter per device.
    "IP_DAILY": "5"
  },
  "observability": { "enabled": true }
}
