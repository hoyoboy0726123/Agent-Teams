{
  "name": "agent-teams",
  "version": "0.2.0",
  "description": "Open-source multi-agent team workspace: humans and many AI agents collaborating in real-time channels with persistent, governable memory. Works with Claude / Codex subscriptions, 10+ API providers and local Ollama models.",
  "type": "module",
  "main": "server/index.js",
  "bin": {
    "agent-teams": "server/index.js"
  },
  "scripts": {
    "start": "node --no-warnings --env-file-if-exists=.env server/index.js",
    "dev": "node --no-warnings --env-file-if-exists=.env --watch server/index.js",
    "test": "node --no-warnings --test test/*.test.js",
    "build:vendor": "esbuild tools/collab-entry.js --bundle --format=esm --minify --legal-comments=none --outfile=web/vendor/collab.js"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "pptxgenjs": "^4.0.1",
    "unpdf": "^1.8.1",
    "ws": "^8.18.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32"
  },
  "optionalDependencies": {
    "playwright-core": "^1.56.1"
  },
  "devDependencies": {
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "y-codemirror.next": "^0.3.6"
  }
}
